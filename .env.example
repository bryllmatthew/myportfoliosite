# Copy to .env.local and fill in. Never commit real values.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by scripts/create-admin.mjs for bootstrapping the first admin.
# The web application never reads this value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Random string used to hash visitor IPs for contact-form rate limiting.
INQUIRY_HASH_SALT=

# Optional, server-only. When set, each new inquiry is POSTed as JSON to this URL
# (Zapier, Make, n8n, GoHighLevel inbound webhook, Slack workflow, etc.).
INQUIRY_WEBHOOK_URL=
